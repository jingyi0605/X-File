{
  "name": "x-file",
  "version": "0.1.0",
  "private": true,
  "description": "X-File 文档库独立应用骨架",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:server": "bash scripts/dev-server.sh",
    "dev:desktop": "pnpm --filter @x-file/desktop tauri:dev",
    "dev:desktop:frontend": "bash scripts/dev-desktop-frontend.sh",
    "dev:desktop:mirror": "bash scripts/dev-desktop-mirror.sh",
    "sample:generate": "node scripts/generate-sample-x-file-library.mjs",
    "sample:start": "bash scripts/start-sample-x-file-desktop.sh",
    "sample:start:web": "bash scripts/start-sample-x-file.sh",
    "start:server": "pnpm --filter @x-file/server start",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "report:preview-capabilities": "node scripts/report-preview-capabilities.mjs",
    "package:desktop": "bash scripts/package-desktop.sh",
    "package:desktop:macos": "bash scripts/package-desktop.sh macos",
    "package:desktop:windows": "bash scripts/package-desktop.sh windows",
    "package:desktop:linux": "bash scripts/package-desktop.sh linux",
    "package:desktop:all": "bash scripts/package-all-platforms.sh all",
    "prepare:bundled-server": "bash scripts/archive/20260616/prepare-bundled-server.sh",
    "prepare:library-engine": "bash scripts/archive/20260616/prepare-bundled-server.sh",
    "version:set": "node scripts/version.mjs set",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "test:version": "node --test scripts/version.test.mjs",
    "benchmark:index": "node scripts/benchmark-native-library.mjs",
    "test:agent-tools": "node --test scripts/agent-tools.test.mjs"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
