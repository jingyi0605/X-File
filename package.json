{
  "name": "x-file",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "X-File 文档库独立应用骨架",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:server": "bash scripts/dev-server.sh",
    "dev:desktop": "pnpm --filter @x-file/desktop tauri:dev",
    "start:server": "pnpm --filter @x-file/server start",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "package:desktop": "bash scripts/package-desktop.sh",
    "package:desktop:macos": "bash scripts/package-desktop.sh macos",
    "package:desktop:windows": "bash scripts/package-desktop.sh windows",
    "prepare:bundled-server": "bash scripts/archive/20260616/prepare-bundled-server.sh",
    "prepare:library-engine": "bash scripts/archive/20260616/prepare-bundled-server.sh",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
