{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X-File",
  "version": "0.1.0-beta.6",
  "identifier": "top.codingns.xfile",
  "build": {
    "beforeDevCommand": "bash -lc 'for p in ./scripts/dev-desktop-stack.sh ../scripts/dev-desktop-stack.sh ../../scripts/dev-desktop-stack.sh ../../../scripts/dev-desktop-stack.sh; do if [ -f \"$p\" ]; then exec bash \"$p\"; fi; done; echo \"dev-desktop-stack.sh not found from $(pwd)\" >&2; exit 1'",
    "devUrl": "http://127.0.0.1:17320",
    "beforeBuildCommand": "node ../../../scripts/prepare-desktop-build.mjs",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "X-File",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "label": "main",
        "resizable": true,
        "acceptFirstMouse": true,
        "transparent": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 23
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "X-File 文档库独立应用",
    "longDescription": "X-File 是从 CodingNS 拆出的本机文档库应用。桌面安装包使用签名更新，支持 stable/beta 通道和可配置的国内镜像更新源。",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/x-file-resource-boundary.json": "x-file-resource-boundary.json"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4N0ExMDM3REVDNkIwMDQKUldRRXNNYmVOeEI2S096UlU1cXlJUlBIYXJZcXlUVWVzM3gvRi9FckRjZHJzRHd5RmtGdkdMMW4K",
      "endpoints": [
        "https://github.com/jingyi0605/X-File/releases/latest/download/latest.json"
      ]
    }
  }
}
