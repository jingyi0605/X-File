  {
    "name": "xfile_tags_create",
    "description": "创建标签，可附带智能规则。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "disabled"
          ]
        },
        "smartRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "and",
                  "or",
                  "not"
                ]
              },
              "ruleType": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "file_name_contains",
                  "file_content_contains",
                  "file_extension_in",
                  "document_path_in_folder",
                  "modified_time_between"
                ]
              },
              "matcher": {
                "type": "object",
                "properties": {
                  "keyword": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "extensions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "maxItems": 100
                  },
                  "folderPath": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "additionalProperties": false
              },
              "enabled": {
                "type": "boolean"
              },
              "priority": {
                "type": "integer"
              }
            },
            "required": [
              "ruleType",
              "matcher"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "ruleType": {
                      "enum": [
                        "file_name_contains",
                        "file_content_contains"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "matcher": {
                      "required": [
                        "keyword"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "ruleType": {
                      "const": "file_extension_in"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "matcher": {
                      "required": [
                        "extensions"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "ruleType": {
                      "const": "document_path_in_folder"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "matcher": {
                      "required": [
                        "folderPath"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "ruleType": {
                      "const": "modified_time_between"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "matcher": {
                      "anyOf": [
                        {
                          "required": [
                            "start"
                          ]
                        },
                        {
                          "required": [
                            "end"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 100
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "requiresBinding": true
    }
  },
