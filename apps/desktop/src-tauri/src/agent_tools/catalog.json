  {
    "name": "xfile_file_read",
    "description": "分块读取 UTF-8 或 Base64 文件，返回完整内容 SHA-256 version、截断标记和下一字节偏移；文件上限 20 MiB。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "绑定资料库内的相对路径，不允许上级路径或内部状态目录"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "utf8",
            "base64"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20971520
        },
        "limitBytes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 262144
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "requiresBinding": true
    }
  },
  {
    "name": "xfile_file_operation",
    "description": "创建、复制、移动、删除或覆盖资料库文件；写入需要读取时的 expectedVersion。变更后同步刷新索引；indexUpdated:false 时文件仍已修改，请只重试索引。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "opType": {
          "type": "string",
          "enum": [
            "create_file",
            "create_directory",
            "copy",
            "move",
            "delete",
            "write"
          ]
        },
        "srcPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "绑定资料库内的相对路径，不允许上级路径或内部状态目录"
        },
        "dstPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "绑定资料库内的相对路径，不允许上级路径或内部状态目录"
        },
        "content": {
          "type": "string",
          "maxLength": 524288
        },
        "expectedVersion": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recursive": {
          "type": "boolean"
        }
      },
      "required": [
        "opType"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "opType": {
                "enum": [
                  "create_file",
                  "create_directory"
                ]
              }
            }
          },
          "then": {
            "required": [
              "dstPath"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "opType": {
                "enum": [
                  "copy",
                  "move"
                ]
              }
            }
          },
          "then": {
            "required": [
              "srcPath",
              "dstPath"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "opType": {
                "enum": [
                  "delete"
                ]
              }
            }
          },
          "then": {
            "required": [
              "srcPath"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "opType": {
                "enum": [
                  "write"
                ]
              }
            }
          },
          "then": {
            "required": [
              "srcPath",
              "content",
              "expectedVersion"
            ]
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "requiresBinding": true
    }
  },
